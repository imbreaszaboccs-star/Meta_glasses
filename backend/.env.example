# Copy to .env and fill in. Never commit .env.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared secret the phone app sends as "Authorization: Bearer <APP_TOKEN>".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# Optional overrides (defaults shown)
# HINT_MODEL=gemini-3.5-flash-lite
# HINT_THINKING=minimal
# HINT_FALLBACK_MODEL=gemini-3.1-flash-lite
# HINT_FALLBACK_THINKING=minimal
# TTS_MODEL=gemini-3.8-flash-lite-tts
# TTS_VOICE=Kore
# MAX_AUDIO_MB=10
# MAX_PHOTO_MB=5
# GEMINI_TIMEOUT_S=10
